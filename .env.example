# Copy to .env.local for local use, and add the same keys in Vercel → Settings → Environment Variables.

# Postgres connection string (not an API key). Leave unset locally to use data/db.json.
#  Supabase: project → Connect → "Transaction pooler" (port 6543), with your database password filled in
#  Neon:     project → Connect → "Pooled connection"
DATABASE_URL=

# Long random string that signs login cookies. Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# First admin, created only when the database is empty. Never commit the real password.
ADMIN_EMAIL=abielanabielan@gmail.com
ADMIN_PASSWORD=

# Restaurant time zone offset from UTC in minutes (India = 330). Used for "today" and daily bills.
APP_UTC_OFFSET_MINUTES=330

# How often screens refresh, in ms. 2500 feels instant; 4000 halves Vercel function calls.
NEXT_PUBLIC_POLL_MS=3000
